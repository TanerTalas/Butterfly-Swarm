# Butterfly Garden — ortam değişkenleri
#
# Bu dosyayı `.env.local` olarak kopyala ve doldur. `.env.local` git'e
# GİRMİYOR (.gitignore → `.env*.local`).
#
# ⚠ Hiçbiri `NEXT_PUBLIC_` DEĞİL ve olmamalı. Tarayıcı Supabase ile hiç
# konuşmuyor (bkz. lib/supabase/server.ts); `NEXT_PUBLIC_` öneki eklemek
# anahtarı sayfa kaynağına gömer.

# Supabase → Project Settings → Data API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role
# ⚠ RLS'i atlar. Sunucu dışına asla çıkmamalı.
SUPABASE_SERVICE_ROLE_KEY=
